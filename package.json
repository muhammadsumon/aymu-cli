{
  "name": "aymu",
  "version": "1.0.0",
  "description": "The Aymu customer installer: verifies signed, immutable releases and installs them into an Astro project safely.",
  "license": "MIT",
  "author": "Muhammad Sumon",
  "homepage": "https://aymu.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muhammadsumon/aymu-cli.git"
  },
  "bugs": {
    "url": "https://github.com/muhammadsumon/aymu-cli/issues"
  },
  "keywords": [
    "astro",
    "templates",
    "sections",
    "installer",
    "cli",
    "mcp"
  ],
  "type": "module",
  "bin": {
    "aymu": "./dist/aymu.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.23.4"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "fflate": "0.8.3",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "zod": "4.6.7"
  }
}
